# Токен бота — получить у @BotFather
BOT_TOKEN=

# Ключ Groq API — получить на https://console.groq.com/keys
GROQ_API_KEY=

# Модель Groq (можно менять)
GROQ_MODEL=openai/gpt-oss-120b

# Лимиты и подписка
FREE_REQUESTS_PER_DAY=5
SUBSCRIPTION_PRICE_STARS=150
SUBSCRIPTION_DAYS=30

# Оплата картой через ЮKassa (Telegram Payments). Получить provider_token:
# @BotFather -> /mybots -> выбрать бота -> Bot Settings -> Payments -> ЮKassa
# (нужен подключённый аккаунт ЮKassa — самозанятый/ИП/юрлицо, это требование ЮKassa).
# Пока токен не задан — кнопка оплаты картой не показывается, доступна только оплата Stars.
YOOKASSA_PROVIDER_TOKEN=
SUBSCRIPTION_PRICE_RUB=100

# Администраторы (юзернеймы через запятую, без @) — безлимитный доступ навсегда
ADMIN_USERNAMES=Abc123qwerty09

# Путь к файлу базы данных
DB_PATH=bot.db

# Память диалога
SHORT_HISTORY_MESSAGES=6
LONG_HISTORY_MESSAGES=30
FREE_CONTEXT_TTL_MINUTES=15

# Реферальная программа
REFERRAL_BONUS_REQUESTS=5
REFERRAL_SUBSCRIPTION_BONUS_REQUESTS=50

# Напоминание об окончании подписки
REMINDER_DAYS_BEFORE=1
REMINDER_CHECK_INTERVAL_HOURS=6

# Стрик и геймификация
STREAK_BONUS_EVERY_DAYS=7
STREAK_BONUS_REQUESTS=2
STREAK_DISCOUNT_PERCENT=10

# Золотой запрос
GOLDEN_QUERY_INTERVAL_DAYS=7

# Динамическая скидка за активность
DYNAMIC_DISCOUNT_ACTIVE_DAYS=3
DYNAMIC_DISCOUNT_PERCENT=50
DYNAMIC_DISCOUNT_WINDOW_HOURS=6

# Модели для мультимодальных функций (голос, фото, веб-поиск)
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_SEARCH_MODEL=groq/compound-mini

# RAG (база знаний)
RAG_CHUNK_SIZE=800
RAG_TOP_K=4
RAG_MAX_CHUNKS_TOTAL=3000

# Rate limiting и анти-спам
TEXT_COOLDOWN_SECONDS=2
SPAM_WINDOW_SECONDS=10
SPAM_MAX_MESSAGES=6
SPAM_BLOCK_SECONDS=30
SEARCH_COOLDOWN_SECONDS=10

# Мультимодальность
VOICE_MAX_DURATION_SECONDS=120

# Поиск музыки (только по подписке): поиск по названию и Shazam-распознавание работают
# без ключей "из коробки". Для поиска по словам из песни нужен бесплатный токен Genius:
# https://genius.com/api-clients -> New API Client -> Client Access Token
GENIUS_ACCESS_TOKEN=
SHAZAM_CLIP_SECONDS=20
MUSIC_RESULTS_LIMIT=5
